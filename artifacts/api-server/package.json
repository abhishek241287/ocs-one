{
  "name": "@workspace/api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:authz": "tsx src/cert/authz-suite.ts",
    "test:audit": "tsx src/cert/audit-suite.ts",
    "test:session": "tsx src/cert/session-suite.ts",
    "test:task35-transfer-domain": "tsx src/cert/task35-transfer-domain-suite.ts",
    "test:config": "tsx src/cert/config-suite.ts",
    "cert:fat:seed": "tsx src/cert/fat-seed.ts --action=seed",
    "cert:fat:verify": "tsx src/cert/fat-seed.ts --action=verify",
    "cert:fat:preflight": "tsx src/cert/fat-seed.ts --action=preflight",
    "cert:fat:smoke": "FAT_READONLY_ONLY=1 tsx src/cert/fat-journey-evidence.ts",
    "cert:fat:teardown": "tsx src/cert/fat-seed.ts --action=teardown",
    "test:fat:preflight-drift": "tsx src/cert/fat-preflight-drift-suite.ts",
    "test:fat": "pnpm run cert:fat:seed && pnpm run cert:fat:verify",
    "test:fat:reports": "FAT_REPORTS_ONLY=1 tsx src/cert/fat-journey-evidence.ts",
    "test:fat:journey": "tsx src/cert/fat-journey-evidence.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/ecf": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
